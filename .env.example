APP_NAME="Your Company Name"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=carhire
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Used once by `php artisan db:seed` to create the dashboard login.
ADMIN_NAME="Site Admin"
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-this-password
