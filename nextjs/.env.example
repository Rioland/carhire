# Copy to .env for local development. On Vercel, set these under
# Settings -> Environment Variables instead. .env is gitignored: never commit
# the real password.

# The Hostinger mailbox the site authenticates as, and its password.
# This must be a real mailbox on the domain, created in hPanel -> Emails.
EMAIL_USER=support@folafemzglobal.com
EMAIL_PASSWORD=your-mailbox-password

# Where enquiries are delivered. Defaults to EMAIL_USER when unset, so set this
# only if you want them to land somewhere else.
EMAIL_TO=support@folafemzglobal.com

# Hostinger SMTP. 465 is implicit TLS; use 587 only if 465 is blocked.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465

# Canonical origin, used for canonical tags, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://folafemzglobal.com
